<Window x:Class="Project.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jelgava POI" Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top" Background="Black">
            <Grid Width="760">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.8*"/>
                    <ColumnDefinition Width="0.9*"/>
                    <ColumnDefinition Width="0.38*"/>
                    <ColumnDefinition Width="0.63*"/>
                    <ColumnDefinition Width="0.76*"/>
                    <ColumnDefinition Width="0.67*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" SelectedIndex="0" Name="categoryComboBox" Width="100" SelectionChanged="categoryComboBox_SelectionChanged">
                </ComboBox>
                <Button Grid.Column="1" Name="SortingButton" Foreground="White" FontWeight="Bold" FontFamily="Verdana" Background="Black" BorderBrush="White" Content="Sort by: Category" Click="SortingButton_Click"/>
                <TextBlock Grid.Column="2" Margin="10 4 0 0" Foreground="White" FontWeight="Bold" FontFamily="Verdana">Filter: |</TextBlock>
                <CheckBox Grid.Column="3" Name="RatingCheckBox" Content="4+ Rating |" Click="FilterCheckBoxR_Click" Foreground="White" FontWeight="Bold" FontFamily="Verdana" Margin="0,5,0,0"></CheckBox>
                <CheckBox Grid.Column="4" Name="DistanceCheckBox" Content="1km Distance |" Click="FilterCheckBoxD_Click" Foreground="White" FontWeight="Bold" FontFamily="Verdana" Margin="0,5,0,0"></CheckBox>
                <CheckBox Grid.Column="5" Name="Open247CheckBox" Content="24/7 Open |" Click="FilterCheckBoxO_Click" Margin="0,5,0,0" Foreground="White" FontWeight="Bold" FontFamily="Verdana"></CheckBox>
                <TextBox Grid.Column="6"  x:Name="SearchTextBox" Width="95" Height="20" HorizontalAlignment="Left" TextChanged="SearchTextBox_TextChanged"/>
                <Button Grid.Column="6" Content="Search" Click="Search_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="White" FontWeight="Bold" FontFamily="Verdana" Background="Black" BorderBrush="White"/>
            </Grid>
        </ToolBar>

        <ListView Name="PlacesListBox" SelectionChanged="placeListBox_SelectionChanged" Width="250">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" />
                        <TextBlock Text=" - " />
                        <TextBlock Foreground="Gray" x:Name="valueText"/>
                    </StackPanel>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding DataContext.CurrentSortingMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Category">
                            <Setter TargetName="valueText" Property="Text" Value="{Binding Category}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding DataContext.CurrentSortingMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Rating">
                            <Setter TargetName="valueText" Property="Text" Value="{Binding Rating, StringFormat={}{0:F1}★}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding DataContext.CurrentSortingMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Closest">
                            <Setter TargetName="valueText" Property="Text" Value="{Binding DistanceFromCenter, StringFormat={}{0:F1}km}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StatusBar>

            <Canvas>
                <StackPanel x:Name="panel" DataContext="{Binding}" HorizontalAlignment="Center" Width="300" VerticalAlignment="Top" Canvas.Top="-240" Height="400" Visibility="Hidden">

                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold"/>

                    <TextBlock Text="Description:" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Info}" TextWrapping="Wrap"/>

                    <TextBlock Text="Address:" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Address}" TextWrapping="Wrap"/>

                    <TextBlock Text="Rating:" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Rating}"/>

                    <TextBlock Text="Schedule:" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Schedule[0]}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Schedule[1]}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Schedule[2]}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Schedule[3]}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Schedule[4]}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Schedule[5]}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Schedule[6]}" TextWrapping="Wrap"/>

                    <Image Source="{Binding ImagePath}" Width="200" Height="150" Stretch="Uniform"/>
                </StackPanel>
                <Button Content="Map view" Click="ToMapView_Click" Canvas.Top="200" Canvas.Left="370" Height="50" Width="150" FontSize="26"/>
            </Canvas>
        </StatusBar>
    </DockPanel>
</Window>